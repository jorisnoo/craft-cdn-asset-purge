{
    "name": "jorisnoo/craft-cdn-asset-purge",
    "description": "Purge CDN URLs when Craft CMS assets are replaced, renamed, moved, or deleted.",
    "keywords": [
        "craftcms",
        "cdn",
        "purge",
        "assets"
    ],
    "homepage": "https://github.com/jorisnoo/craft-cdn-asset-purge",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Joris Noordermeer",
            "email": "contact@noordermeer.ch",
            "homepage": "https://github.com/jorisnoo",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/jorisnoo/craft-cdn-asset-purge",
        "issues": "https://github.com/jorisnoo/craft-cdn-asset-purge/issues"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Noo\\CraftCdnAssetPurge\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
